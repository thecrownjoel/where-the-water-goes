{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Where the Water Goes",
  "version": "0.1.0",
  "identifier": "org.wherethewatergoes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.waterdata.usgs.gov",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Public U.S. water data as a living visualization",
    "copyright": "Where the Water Goes contributors. Data: USGS, NOAA (public domain); Natural Earth (public domain).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 340
        },
        "appPosition": {
          "x": 150,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Where the Water Goes contributors",
    "homepage": "https://github.com/thecrownjoel/where-the-water-goes",
    "longDescription": "A screensaver and desktop visualization of live public U.S. water data: about 8,500 USGS stream gauges, rain gauges and lake and reservoir levels on a 3D globe with rivers and terrain. Every value shows its source and time. Optionally shows what your computer contributes to research through BOINC.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/metainfo/org.wherethewatergoes.app.metainfo.xml": "linux/org.wherethewatergoes.app.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/org.wherethewatergoes.app.metainfo.xml": "linux/org.wherethewatergoes.app.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
